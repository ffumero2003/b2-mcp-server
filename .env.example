# Template only. Copy to .env and fill THAT file in -- .env is gitignored.
#
# This file holds NAMES ONLY. Never put a value after an = sign here:
# .env.example is committed to git, .env is not.
#
# Create the key in the Backblaze console under Account > Application Keys.
# Use a regular application key with access to All buckets.
# Read Only is enough for b2_list_buckets and b2_list_files.
# b2_upload_file needs the writeFiles capability, so uploading requires a
# Read and Write key -- a Read Only key fails at the B2 API, by design.
# Do NOT use the master application key: it carries every capability,
# cannot be scoped, and cannot be deleted -- only regenerated.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Optional. The ONLY directory b2_upload_file may read local files from.
# Uploads deny by default: leave this unset and every upload is refused.
# Paths are resolved with realpath before the containment check, so a symlink
# inside this directory cannot point outside it.
B2_UPLOAD_ROOT=
