# Template only. Copy to .env and fill THAT file in -- .env is gitignored.
#
# This file holds NAMES ONLY. Never put a value after an = sign here:
# .env.example is committed to git, .env is not.
#
# Create the key in the Backblaze console under Account > Application Keys.
# Use a regular application key with access to All buckets.
# Read Only is enough for b2_list_buckets and b2_list_files.
# b2_upload_file needs the writeFiles capability, so uploading requires a
# Read and Write key -- a Read Only key fails at the B2 API, by design.
# Do NOT use the master application key: it carries every capability,
# cannot be scoped, and cannot be deleted -- only regenerated.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Optional. The ONLY directory b2_upload_file may READ local files from.
# Uploads deny by default: leave this unset and every upload is refused.
# Paths are resolved with realpath before the containment check, so a symlink
# inside this directory cannot point outside it.
# NOTE: a relative localPath resolves against THIS directory, not your shell's
# working directory. With a root of ".../uploads", pass "hello.txt".
B2_UPLOAD_ROOT=

# Optional. The ONLY directory b2_download_file may WRITE files to.
# Downloads deny by default, same as uploads. Kept separate from the upload
# root on purpose: read access and write access are granted independently, so
# a wide read directory can pair with a narrow scratch write directory.
B2_DOWNLOAD_ROOT=

# REQUIRED for b2_delete_file_version. A file path, not a directory.
# Deletion is REFUSED when this is unset: nothing is destroyed through this
# server without a record. Append-only JSON Lines, one object per mutation.
# Its parent directory must already exist. This path is NOT fenced, because it
# is operator configuration rather than a caller-supplied path.
B2_AUDIT_LOG=

# Optional. Where a copy of each deleted version is kept before it is
# destroyed. Unset means deletions leave only a manifest record.
# A manifest is NOT a backup: it proves what existed, this keeps the bytes.
# Copies are named "<fileName>.<fileId>" so two versions of one name cannot
# overwrite each other in the archive.
B2_ARCHIVE_ROOT=
